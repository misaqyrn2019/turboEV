# Server-only variables. Add these in Vercel Project > Settings > Environment Variables.
# Use a Turso libSQL database (SQLite-compatible), not the newer Turso engine.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=
# Used only when the database has no users. Set your existing password (10+ chars).
FLEET_ADMIN_PASSWORD=
# Optional comma-separated custom domains; Vercel deployment URLs are automatic.
FLEET_ALLOWED_HOSTS=
